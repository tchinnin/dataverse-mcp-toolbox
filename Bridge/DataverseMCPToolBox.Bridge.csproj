<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <AssemblyName>DataverseMCPToolBox.Bridge</AssemblyName>
    <TrimMode>link</TrimMode>
    
    <!-- Optimizations for Package Size -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Disable threading analyzer warnings and suppress trimming warnings -->
    <NoWarn>$(NoWarn);VSTHRD103;VSTHRD002;IL2026;IL2104</NoWarn>
    
    <!-- Assembly Version (Bridge is bundled into DataverseMCPToolBox.Runtime package, not published separately) -->
    <AssemblyVersion>0.1.2602.5</AssemblyVersion>
    <FileVersion>0.1.2602.5</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Core for shared Abstractions -->
    <ProjectReference Include="..\Core\DataverseMCPToolBox.csproj">
      <!-- Only include Abstractions, not the executable -->
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc for JSON-RPC communication -->
    <PackageReference Include="StreamJsonRpc" Version="2.19.27" />
    
    <!-- Newtonsoft.Json for JSON serialization with camelCase -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
