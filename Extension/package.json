{
  "name": "dataverse-mcp-toolbox",
  "displayName": "Dataverse MCP ToolBox",
  "description": "Manage Dataverse connections and expose MCP tools for GitHub Copilot",
  "version": "0.0.1",
  "publisher": "tchinnin",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dataverse MCP ToolBox",
      "properties": {
        "dataverse.server.channel": {
          "type": "string",
          "enum": [
            "stable",
            "prerelease"
          ],
          "default": "prerelease",
          "description": "Update channel for MCP server - determines which latest version to install (stable or prerelease)"
        },
        "dataverse.server.enforcedVersion": {
          "type": "string",
          "default": "",
          "description": "Specific server version to enforce (e.g., '0.1.0-alpha'). Leave empty to always use the latest version from the selected channel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dataverse-connections",
          "title": "Dataverse Connections",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "dataverse-connections": [
        {
          "id": "dataverseConnectionsList",
          "name": "Connections"
        },
        {
          "id": "dataversemcptoolbox.pluginsView",
          "name": "MCP Plugins"
        },
        {
          "id": "dataversemcptoolbox.serverInfoView",
          "name": "MCP Server Info"
        }
      ]
    },
    "commands": [
      {
        "command": "dataversemcptoolbox.addConnection",
        "title": "Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "dataversemcptoolbox.removeConnection",
        "title": "Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "dataversemcptoolbox.setActiveConnection",
        "title": "Set as Active Connection",
        "icon": "$(star-empty)"
      },
      {
        "command": "dataversemcptoolbox.refreshConnections",
        "title": "Refresh Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "dataversemcptoolbox.showWhoAmI",
        "title": "Show WhoAmI Info",
        "icon": "$(question)"
      },
      {
        "command": "dataversemcptoolbox.refreshPlugins",
        "title": "Refresh Plugins",
        "icon": "$(refresh)"
      },
      {
        "command": "dataversemcptoolbox.installPlugin",
        "title": "Install Plugin from NuGet",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dataversemcptoolbox.uninstallPlugin",
        "title": "Uninstall Plugin",
        "icon": "$(trash)"
      },
      {
        "command": "dataversemcptoolbox.callTool",
        "title": "Execute Tool",
        "icon": "$(play)"
      },
      {
        "command": "dataversemcptoolbox.updateServer",
        "title": "Dataverse: Check for Server Updates",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dataversemcptoolbox.upgradeServer",
        "title": "Upgrade MCP Server",
        "icon": "$(arrow-up)"
      },
      {
        "command": "dataversemcptoolbox.checkServerUpdates",
        "title": "Check for Server Updates",
        "icon": "$(refresh)"
      },
      {
        "command": "dataversemcptoolbox.configureServerSettings",
        "title": "Configure Server Settings",
        "icon": "$(settings)"
      },
      {
        "command": "dataversemcptoolbox.toggleServerChannel",
        "title": "Toggle Server Channel",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "dataversemcptoolbox.toggleEnforcedVersion",
        "title": "Set Enforced Version",
        "icon": "$(tag)"
      },
      {
        "command": "dataversemcptoolbox.openMcpConfiguration",
        "title": "Dataverse: Open MCP Configuration",
        "icon": "$(file-code)"
      },
      {
        "command": "dataversemcptoolbox.reregisterMcpServer",
        "title": "Dataverse: Re-register MCP Server",
        "icon": "$(sync)"
      },
      {
        "command": "dataversemcptoolbox.unregisterMcpServer",
        "title": "Dataverse: Unregister MCP Server",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dataversemcptoolbox.addConnection",
          "when": "view == dataverseConnectionsList",
          "group": "navigation"
        },
        {
          "command": "dataversemcptoolbox.refreshConnections",
          "when": "view == dataverseConnectionsList",
          "group": "navigation"
        },
        {
          "command": "dataversemcptoolbox.refreshPlugins",
          "when": "view == dataversemcptoolbox.pluginsView",
          "group": "navigation"
        },
        {
          "command": "dataversemcptoolbox.installPlugin",
          "when": "view == dataversemcptoolbox.pluginsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dataversemcptoolbox.showWhoAmI",
          "when": "view == dataverseConnectionsList && viewItem == activeConnection",
          "group": "inline@1"
        },
        {
          "command": "dataversemcptoolbox.setActiveConnection",
          "when": "view == dataverseConnectionsList && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dataversemcptoolbox.removeConnection",
          "when": "view == dataverseConnectionsList && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dataversemcptoolbox.removeConnection",
          "when": "view == dataverseConnectionsList && viewItem == activeConnection",
          "group": "inline@2"
        },
        {
          "command": "dataversemcptoolbox.uninstallPlugin",
          "when": "view == dataversemcptoolbox.pluginsView && viewItem == plugin",
          "group": "inline"
        },
        {
          "command": "dataversemcptoolbox.callTool",
          "when": "view == dataversemcptoolbox.pluginsView && viewItem == tool",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "copy-local-server": "bash scripts/copy-local-server.sh",
    "dev": "npm run compile && npm run copy-local-server"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "vscode-jsonrpc": "^8.2.0"
  }
}
