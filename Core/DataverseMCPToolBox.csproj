<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <TrimMode>link</TrimMode>
    
    <!-- Optimizations for Package Size -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Suppress trimming warnings (IL2026: reflection in Dataverse SDK, IL2104: assembly load) -->
    <NoWarn>VSTHRD103;IL2026;IL2104</NoWarn>
    
    <!-- Assembly Version (must be numeric with parts <= 65535) -->
    <AssemblyVersion>0.2.2602.4</AssemblyVersion>
    <FileVersion>0.2.2602.4</FileVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>DataverseMCPToolBox.Runtime</PackageId>
    <Version>0.2.260204-beta</Version>
    <Authors>Théophile CHIN-NIN</Authors>
    <Company>tchinnin</Company>
    <Description>Runtime package for Dataverse MCP Toolbox. Contains Core Server and Bridge binaries for all supported platforms (macOS, Windows, Linux).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</PackageProjectUrl>
    <PackageTags>dataverse;mcp;server;model-context-protocol;power-platform;runtime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.1.32" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.61.3" />
    <PackageReference Include="StreamJsonRpc" Version="2.19.27" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NuGet.Protocol" Version="6.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Extensibility\DataverseMCPToolBox.Extensibility.csproj" />
  </ItemGroup>

  <!-- Include README in NuGet package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Include platform-specific binaries in NuGet package -->
  <!-- Core Server binaries (executables only, exclude .pdb and .xml) -->
  <ItemGroup>
    <None Include="publish/osx-arm64/DataverseMCPToolBox" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="publish/osx-x64/DataverseMCPToolBox" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="publish/win-x64/DataverseMCPToolBox.exe" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="publish/linux-x64/DataverseMCPToolBox" Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>

  <!-- Bridge binaries (executables only, exclude .pdb and .xml) -->
  <ItemGroup>
    <None Include="../Bridge/publish/osx-arm64/DataverseMCPToolBox.Bridge" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="../Bridge/publish/osx-x64/DataverseMCPToolBox.Bridge" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="../Bridge/publish/win-x64/DataverseMCPToolBox.Bridge.exe" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="../Bridge/publish/linux-x64/DataverseMCPToolBox.Bridge" Pack="true" PackagePath="runtimes/linux-x64/native/" />
  </ItemGroup>

</Project>
