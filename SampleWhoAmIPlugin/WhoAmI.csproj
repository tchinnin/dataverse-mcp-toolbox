<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Assembly Version -->
    <AssemblyVersion>0.2.2602.5</AssemblyVersion>
    <FileVersion>0.2.2602.5</FileVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>DataverseMCPToolBox.WhoAmI</PackageId>
    <Version>0.2.260204-beta</Version>
    <Authors>Théophile CHIN-NIN</Authors>
    <Company>tchinnin</Company>
    <Description>WhoAmI plugin for DataverseMCPToolBox - retrieves current Dataverse user information</Description>
    <PackageTags>dataverse;mcp;plugin;whoami;extensibility</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</RepositoryUrl>
    <PackageProjectUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production: Use NuGet package reference -->
    <PackageReference Include="DataverseMCPToolBox.Extensibility" Version="0.2.260204-beta" />
    <!-- Local development: Uncomment line below and comment PackageReference above -->
    <!-- <ProjectReference Include="../Extensibility/DataverseMCPToolBox.Extensibility.csproj" /> -->
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
