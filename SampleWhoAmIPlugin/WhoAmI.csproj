<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- NuGet Package Metadata -->
    <PackageId>DataverseMCPToolBox.WhoAmI</PackageId>
    <Version>1.1.0-alpha</Version>
    <Authors>Théophile CHIN-NIN</Authors>
    <Company>tchinnin</Company>
    <Description>WhoAmI plugin for DataverseMCPToolBox - retrieves current Dataverse user information</Description>
    <PackageTags>dataverse;mcp;plugin;sample;whoami;extensibility</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</RepositoryUrl>
    <PackageProjectUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use ProjectReference for local development -->
    <ProjectReference Include="../Extensibility/DataverseMCPToolBox.Extensibility.csproj" />
    <!-- Use PackageReference when publishing to NuGet -->
    <!-- <PackageReference Include="DataverseMCPToolBox.Extensibility" Version="0.1.0-alpha" /> -->
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
