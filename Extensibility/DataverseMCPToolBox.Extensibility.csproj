<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- NuGet Package Metadata -->
    <PackageId>DataverseMCPToolBox.Extensibility</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Théophile CHIN-NIN</Authors>
    <Company>tchinnin</Company>
    <Description>Extensibility SDK for building MCP (Model Context Protocol) plugins for Dataverse operations. Provides interfaces, base classes, and utilities for creating custom tools that extend the DataverseMCPToolBox server.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dataverse;mcp;plugin;extensibility;model-context-protocol;power-platform</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tchinnin/dataverse-mcp-toolbox</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.1.32" />
    <PackageReference Include="NJsonSchema" Version="11.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
